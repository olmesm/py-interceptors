{% set flag = ctx.changelog_insertion_flag %}
{% set parts = (ctx.prev_changelog_file | read_file | safe).split(flag, maxsplit=1) %}
{% set bottom = parts[1] | trim if parts | length > 1 else "" %}
{{ parts[0] | trim }}

{{ flag }}
{% for release in (ctx.history.released.values() | list)[:1] if ("## " ~ release.version.as_semver_tag() ~ " ") not in bottom %}

## {{ release.version.as_semver_tag() }} ({{ release.tagged_date.strftime("%Y-%m-%d") }})
{% set breaking = [] %}
{% for type_, commits in release["elements"] | dictsort if type_ != "unknown" %}

### {{ type_ | title }}

{% for commit in commits if commit.error is undefined %}
- {{ commit.descriptions[0] | trim }} ([`{{ commit.short_hash }}`]({{ commit.hexsha | commit_hash_url }}))
{% if commit.breaking_descriptions %}{% set _ = breaking.append(commit) %}{% endif %}
{% endfor %}
{% endfor %}
{% if breaking %}

### Breaking Changes

{% for commit in breaking %}
- {{ commit.breaking_descriptions | join(" ") | trim }}
{% endfor %}
{% endif %}
{% endfor %}
{% if bottom %}

{{ bottom }}
{% endif %}
